{
  "mcpServers": {
    "chartmogul": {
      "command": "chartmogul",
      "args": ["mcp"]
    },
    "helpscout": {
      "command": "helpscout",
      "args": ["mcp"]
    },
    "omnifocus": {
      "command": "of",
      "args": ["mcp"]
    },
    "superset": {
      "type": "http",
      "url": "https://api.superset.sh/api/agent/mcp"
    },
    "ynab": {
      "command": "ynab",
      "args": ["mcp"]
    },
    "tool-registry": {
      "command": "node",
      "args": [
        "${HOME}/.dotfiles/ai/mcp-servers/tool-registry/index.js",
        "${HOME}/.dotfiles/ai/"
      ]
    },
    "fff": {
      "type": "stdio",
      "command": "/opt/homebrew/bin/fff-mcp",
      "args": [],
      "env": {}
    },
    "lightpanda": {
      "type": "stdio",
      "command": "/opt/homebrew/bin/lightpanda",
      "args": ["mcp"],
      "env": {}
    },
    "playwright": {
      "type": "stdio",
      "command": "/opt/homebrew/bin/playwright-mcp",
      "args": [],
      "env": {}
    },
    "markitdown": {
      "type": "stdio",
      "command": "${HOME}/.local/bin/markitdown-mcp",
      "args": [],
      "env": {}
    },
    "pencil": {
      "type": "stdio",
      "command": "${HOME}/.pencil/mcp/visual_studio_code/out/mcp-server-darwin-arm64",
      "args": ["--app", "visual_studio_code", "--agent", "claudeCodeCLI"],
      "env": {}
    },
    "cloudflare": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "turbo-rag": {
      "type": "stdio",
      "command": "${HOME}/my-workspace/ai/turbo-rag/.venv/bin/python",
      "args": ["-m", "turbo_rag.mcp_client"],
      "env": {
        "TURBO_RAG_PROFILE_ROOT": "${HOME}/.cache/turbo-rag",
        "TURBO_RAG_DB_PATH": "${HOME}/my-workspace/ai/turbo-rag/chunks.sqlite",
        "TURBO_RAG_INDEX_PATH": "${HOME}/my-workspace/ai/turbo-rag/poc.tvim",
        "PYTHONPATH": "${HOME}/my-workspace/ai/turbo-rag",
        "EMBEDDER_BASE_URL": "http://127.0.0.1:28080/v1",
        "EMBEDDER_BACKEND": "llamacpp",
        "EMBEDDER_MODEL": "jina-embeddings-v2-code"
      }
    }
  }
}
