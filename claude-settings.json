    "deny": [
      "Bash(rm:-rf /*)",
      "Bash(rm:-rf /)",
      "Bash(rm:-rf ~:*)",
      "Bash(rm:-rf $HOME:*)",
      "Bash(git:push --force origin main)",
      "Bash(git:push --force origin master)",
      "Bash(git:push -f origin main)",
      "Bash(git:push -f origin master)",
      "Bash(git:reset --hard:*)",
      "Bash(git:clean -fd:*)",
      "Bash(psql:-c DROP DATABASE:*)",
      "Bash(psql:-c DROP TABLE:*)",
      "Bash(psql:-c TRUNCATE TABLE:*)",
      "Bash(psql:-c TRUNCATE:*)"
    ],
    "ask": [
      "Bash(gh pr comment:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${HERDR_ENV:-}\" = \"1\" ] || ~/.claude/hooks/notify.sh -s info -q"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/skills/obsidian-second-brain/hooks/obsidian-bg-agent.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/audit-search-tools.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__fff__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/audit-search-tools.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/guard-memory-index-size.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/handle-expansion-postwrite.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/enforce-tool-registry.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/guard-broad-git.sh",
            "if": "Bash(git *)",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/enforce-tool-registry.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/pretool-stash-override.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/nudge-agent-tier.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/nudge-read-conversion.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/skills/obsidian-second-brain/hooks/load_vault_context.py"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/preload-fff-tools.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/refresh-tool-registry.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/inject-vocab-sessionstart.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${HERDR_ENV:-}\" = \"1\" ] || ~/.claude/hooks/notify.sh -s done -q"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/handle-expansion-stop.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/inject-guidelines.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/inject-tool-digest.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/inject-agent-registry.py",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.dotfiles/ai/hooks/tmux-rename-session.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.dotfiles/ai/hooks/herdr-agent-name.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/handle-expansion-stop.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.dotfiles/ai/statusline.sh"
  },
  "enabledPlugins": {
    "compound-engineering@compound-engineering-plugin": true,
    "engineering-library@engineering-tools": true,
    "frontend-design@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "knowledge-audit@engineering-tools": true,
    "knowledge-capture@engineering-tools": true,
    "memory-kit@memory-kit-marketplace": true,
    "promote-to-canon@engineering-tools": true,
    "ralph-loop@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": false,
    "vault-librarian@ai": true
  },
  "extraKnownMarketplaces": {
    "ai": {
      "source": {
        "source": "github",
        "repo": "abhijit-s/ai"
      }
    },
    "compound-engineering": {
      "source": {
