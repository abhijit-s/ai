    },
    "memory-kit-marketplace": {
      "source": {
        "source": "github",
        "repo": "abhijit-s/memory-kit"
      }
    }
  },
  "spinnerTipsOverride": {
    "tips": [
      "Reading your codebase...",
      "Analyzing dependencies...",
      "Checking for bugs...",
      "Optimizing performance...",
      "Writing tests...",
      "Reviewing changes...",
      "Exploring the architecture..."
    ]
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "showMessageTimestamps": true,
  "autoMemoryDirectory": "${HOME}/vaults/workspace/Memory/auto",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "skipAutoPermissionPrompt": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754059139990
  }
}
